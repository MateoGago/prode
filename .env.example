# Copiá este archivo a .env.local y completá con tus claves de Supabase:
#   cp .env.example .env.local
# Las claves están en el dashboard de Supabase → Settings → API.

# --- Públicas (cliente + servidor) ---

# URL del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clave publishable del sistema NUEVO de keys (sb_publishable_...).
# La legacy anon JWT está deprecada — no la uses.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Origin para armar el redirect del OAuth de Google (.../auth/callback).
# En local podés dejarlo: cae al origin del request. En producción, ponelo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo servidor (NUNCA exponer al browser — sin prefijo NEXT_PUBLIC_) ---

# Clave service-role: saltea RLS y el trigger guard_points_awarded.
# La usan las server actions de admin (confirmar-resultado) y los scripts seed/sync.
SUPABASE_SERVICE_ROLE=your-service-role-key

# Opcional. URL del proyecto solo para los scripts seed/sync cuando no está
# NEXT_PUBLIC_SUPABASE_URL (ej: CI). Si esa ya está seteada, dejalo vacío.
# SUPABASE_URL=https://your-project-ref.supabase.co
