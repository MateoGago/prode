# Variables que lee la Supabase CLI para resolver `env(...)` en config.toml.
# Copiá este archivo a supabase/.env y completá los valores:
#   cp supabase/.env.example supabase/.env
# supabase/.env está en .gitignore — no lo commitees.

# --- Login con Google (auth.external.google) ---
# Credenciales OAuth de Google Cloud → APIs & Services → Credentials.
# Si todavía no vas a probar el login con Google, podés dejarlas vacías.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
